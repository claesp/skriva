{
  "realm": "skriva",
  "enabled": true,
  "displayName": "Skriva (development)",
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "bruteForceProtected": true,
  "groups": [
    { "name": "skriva-admins" },
    { "name": "skriva-editors" }
  ],
  "users": [
    {
      "username": "alice",
      "enabled": true,
      "email": "alice@example.com",
      "emailVerified": true,
      "firstName": "Alice",
      "lastName": "Admin",
      "credentials": [{ "type": "password", "value": "alice", "temporary": false }],
      "groups": ["/skriva-admins"]
    },
    {
      "username": "bob",
      "enabled": true,
      "email": "bob@example.com",
      "emailVerified": true,
      "firstName": "Bob",
      "lastName": "Editor",
      "credentials": [{ "type": "password", "value": "bob", "temporary": false }],
      "groups": ["/skriva-editors"]
    },
    {
      "username": "carol",
      "enabled": true,
      "email": "carol@example.com",
      "emailVerified": true,
      "firstName": "Carol",
      "lastName": "Reader",
      "credentials": [{ "type": "password", "value": "carol", "temporary": false }]
    }
  ],
  "clients": [
    {
      "clientId": "skriva",
      "name": "Skriva",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "skriva-dev-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["http://localhost:8080/auth/callback"],
      "webOrigins": ["http://localhost:8080"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:8080/signed-out"
      },
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "full.path": "false",
            "id.token.claim": "true",
            "access.token.claim": "false",
            "userinfo.token.claim": "true",
            "claim.name": "groups"
          }
        }
      ]
    }
  ]
}
