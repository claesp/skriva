# The settings of the Skriva server. See
# https://github.com/claesp/skriva/blob/main/docs/configuration.md
# After a change: systemctl restart skriva

# Necessary settings.
# The database must have the certificate /etc/skriva/tls/postgres.crt and
# the key postgres.key, or a certificate that ca.crt can verify.
SKRIVA_DATABASE_URL=postgres://skriva:CHANGE-ME@localhost/skriva?sslmode=verify-full
SKRIVA_BASE_URL=https://wiki.example.com
SKRIVA_OIDC_ISSUER=https://sso.example.com/realms/example
SKRIVA_OIDC_CLIENT_ID=skriva
SKRIVA_OIDC_CLIENT_SECRET=CHANGE-ME
# 32 random bytes in base64: head -c 32 /dev/urandom | base64
SKRIVA_ENCRYPTION_KEY=
SKRIVA_SYSTEM_ADMIN_GROUP=wiki-system-admins

# Optional settings.
#SKRIVA_LISTEN_ADDR=:8443
# false: HTTP only, behind a reverse proxy with TLS.
#SKRIVA_TLS=true
#SKRIVA_ADMIN_GROUP=wiki-admins
#SKRIVA_LANGUAGE=en
# Set it to false to apply the database migrations only with
# "skriva migrate".
#SKRIVA_AUTO_MIGRATE=true
